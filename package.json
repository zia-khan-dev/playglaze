{
  "name": "playglaze",
  "version": "0.1.0",
  "description": "Glossy, chunky game UI for React Native and the web, drawn in code in any color.",
  "license": "MIT",
  "author": "Zia Khan",
  "keywords": [
    "react-native",
    "react-native-web",
    "game",
    "ui",
    "components",
    "casual-game",
    "buttons"
  ],
  "homepage": "https://github.com/zia-khan-dev/playglaze#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zia-khan-dev/playglaze.git"
  },
  "bugs": {
    "url": "https://github.com/zia-khan-dev/playglaze/issues"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "docs": "cd docs && npm run dev",
    "docs:build": "cd docs && npm run build",
    "check": "npm run typecheck && npm run build && npm run docs:build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.77",
    "react-native-svg": ">=15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.2.3",
    "react-native": "^0.87.1",
    "react-native-svg": "^15.15.5",
    "typescript": "^5.9.3"
  }
}
